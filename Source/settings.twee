:: Setting Dynamicest [widget]

<<widget "dynamicestModTab">>
	<<button "<div class='dynamicest-settings-title'><img src='img/dynamicest/logo.png' onerror=\"javascript:this.style.display='none'\"><span>极致动态</span></div>">>
		<<toggleTab>>
		<<replace #customOverlayContent>><<dynamicestModSetting>><</replace>>
	<</button>>
<</widget>>

<<widget "dynamicestModSetting">>
	<div class="p-2 text-align-center">
		<h3>极致动态 <<print window.modSC2DataManager?.getModLoader()?.getModZip("Dynamicest")?.modInfo?.version ?? "未知版本">></h3>
		<img src="img/dynamicest/logo.png" style="position: absolute; left: calc(50% - 100px); width: 200px; top: 3%; opacity: 0.1; pointer-events: none;">
		<div class="m-2">
			<b class="gold">Needmeet 遇欲</b> 呈现
		</div>
		<div class="m-2">
			<p class="gold m-0">Github发布页</p>
			<a target="_blank" class="link-external" href="https://github.com/ANLINSTUDIO/Degrees-of-Lewdity-DolDynamicest" tabindex="0">Github /ANLINSTUDIO/Degrees-of-Lewdity-DolDynamicest</a>
		</div>
		<div class="m-2">
			<p class="gold m-0">百度贴吧发布帖</p>
			<a target="_blank" class="link-external" href="https://tieba.baidu.com/p/10532247085?fr=personpage" tabindex="0">动态美化 |动态数值/无需框架/完美兼容/模组也适配</a>
		</div>
	</div>
	<br><br><br>
	<div class="settingsGrid">
		<div class="settingsHeader options">全局设置</div>

		<div class="settingsToggleItemWide">
			距离顶部
			<span class="tooltip-anchor linkBlue" tooltip="允许调节动态显示模块距离顶部的高度">(?)</span>
			<br>
			<<numberslider "$Dynamicest.Settings.DynamicestDisplayTop" $Dynamicest.Settings.DynamicestDisplayTop 0 500 1>>
			<br>
			比例调节
			<span class="tooltip-anchor linkBlue" tooltip="允许调节动态显示模块的缩放比例">(?)</span>
			<br>
			<<numberslider "$Dynamicest.Settings.DynamicestDisplayScale" $Dynamicest.Settings.DynamicestDisplayScale 0.1 1 0.05>>
			<br>
			透明度
			<span class="tooltip-anchor linkBlue" tooltip="允许调节动态显示模块的透明度">(?)</span>
			<br>
			<<numberslider "$Dynamicest.Settings.DynamicestDisplayOpacity" $Dynamicest.Settings.DynamicestDisplayOpacity 0.1 1 0.05>>
			<br>
			<br>
			<input type="button" value="设置" onclick='Dynamicest.settingDynamicestDisplayApply()'/>
			<input type="button" value="重设" onclick='Dynamicest.settingDynamicestDisplayReset()'/>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$Dynamicest.Settings.DynamicestDisplayPenetrate" false true autocheck>>
				穿透点击
			</label>
			<span class="tooltip-anchor linkBlue" tooltip="勾选此项后可以穿过提醒弹窗点击文本内容（除了折叠的）">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$Dynamicest.Settings.DynamicestShowNPCAppearance" false true autocheck>>
				人物出场提醒
			</label>
			<span class="tooltip-anchor linkBlue" tooltip="勾选此项后已命名NPC出场时会自动弹窗提醒其属性">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$Dynamicest.Settings.DynamicestFlash" false true autocheck>>
				侧边栏数值改变闪烁动画（如出现卡顿请考虑关闭）
			</label>
			<span class="tooltip-anchor linkBlue" tooltip="勾选此项后即刻更改的数值，背景色会进行闪烁以提醒。可能加大设备负载，如出现卡顿请考虑关闭。">(?)</span>
		</div>
	</div>
	<div class="p-2 text-align-center">
		<h3><span class="teal">键过滤</span>勾选后将不再显示相应的动态</h3>
		<span>可过滤的键列表为动态更新，只有曾经触发过某个键的动态，才能够对其进行过滤。</span><br>
		<span>勾选的键过滤<span class="def">跟随存档</span>，这意味着如果你在某个存档后修改了设置，恢复那个存档将需要重新设置一次。</span>
	</div>
	<div class="settingsGrid">
		<div class="settingsHeader options">特殊过滤</div>

		<div class="settingsToggleItem">
			<label>
				<<checkbox "$Dynamicest.Settings.FilterBodyTemperature" false true autocheck>>
				体温及其变化
			</label>
			<span class="tooltip-anchor linkBlue" tooltip="当玩家的体温或者体温的变化向改变时，将会动态提醒。">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$Dynamicest.Settings.FilterOutside" false true autocheck>>
				室内外变化
			</label>
			<span class="tooltip-anchor linkBlue" tooltip="当玩家从室内切换到室外或者反之时，将会动态提醒。">(?)</span>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$Dynamicest.Settings.FilterComdoms" false true autocheck>>
				避孕套变化
			</label>
		</div>
		<div class="settingsToggleItem">
			<label>
				<<checkbox "$Dynamicest.Settings.FilterSpray" false true autocheck>>
				防狼喷雾变化
			</label>
		</div>

	</div>
	<div class="settingsGrid">
		<div class="settingsHeader options">「侧边栏」键过滤</div>
		<div class="settingsToggleItemWide text-align-center">
			<label>
				<<checkbox "$Dynamicest.Settings.EnableSides" false true autocheck>>
				<span class="gold">侧边栏动态提醒</span> <span>取消勾选此项可以解决与某些模组冲突导致的频繁弹窗问题（更值后重新打开设置）</span>
			</label>
		</div>
		<<if $Dynamicest.Settings.EnableSides>>
			<<for _side range Dynamicest.getFilterOptions("Sides")>>
				<div class="settingsToggleItem">
					<label>
						<<set _key to JSON.stringify(_side.replaceAll(" ", "").replaceAll(" ", "").replaceAll("<", "").replaceAll(">", "").replaceAll("\\", "").replaceAll('"', "").replaceAll("'", "").replaceAll("`", "").replaceAll("=", "").replaceAll("(", "").replaceAll(")", "").replaceAll(",", ""))>>
						<<set _onchange to 'Dynamicest.settingFilter("Sides", ' + _key + ', this.checked)'>>
						<<print '<input type="checkbox" @onchange=_onchange'+Dynamicest.getFilter("Sides", T.key.substring(1, T.key.length-1))+'>'>>
						<div class="box-sides">
							<<print _side>>
						</div>
					</label>
				</div>
			<</for>>
		<</if>>
	</div>
	<div class="settingsGrid">
		<div class="settingsHeader options">「日志」键过滤</div>
		<<for _journal range Dynamicest.getFilterOptions("Journals")>>
			<div class="settingsToggleItem">
				<label>
					<<print '<input type="checkbox" onchange="Dynamicest.settingFilter(`Journals`, `'+_journal+'`, this.checked)"'+Dynamicest.getFilter("Journals", _journal)+'>'>>
					<<print _journal>>
				</label>
			</div>
		<</for>>
	</div>
	<div class="settingsGrid">
		<div class="settingsHeader options">「属性」键过滤</div>
		<<for _characteristic range Dynamicest.getFilterOptions("Characteristics")>>
			<div class="settingsToggleItem">
				<label>
					<<print '<input type="checkbox" onchange="Dynamicest.settingFilter(`Characteristics`, `'+_characteristic+'`, this.checked)"'+Dynamicest.getFilter("Characteristics", _characteristic)+'>'>>
					<<print _characteristic>>
				</label>
			</div>
		<</for>>
	</div>
	<div class="settingsGrid">
		<div class="settingsHeader options">「社交」键过滤</div>
		<<for _relation range Dynamicest.getFilterOptions("Relations")>>
			<div class="settingsToggleItem">
				<label>
					<<print '<input type="checkbox" onchange="Dynamicest.settingFilter(`Relations`, `'+_relation+'`, this.checked)"'+Dynamicest.getFilter("Relations", _relation)+'>'>>
					<<print _relation>>
				</label>
			</div>
		<</for>>
	</div>
	<div class="settingsGrid">
		<div class="settingsHeader options">「特性」键过滤</div>
		<<for _trait range Dynamicest.getFilterOptions("Traits")>>
			<div class="settingsToggleItem">
				<label>
					<<print '<input type="checkbox" onchange="Dynamicest.settingFilter(`Traits`, `'+_trait+'`, this.checked)"'+Dynamicest.getFilter("Traits", _trait)+'>'>>
					<<print _trait>>
				</label>
			</div>
		<</for>>
	</div>
	<br><br>
<</widget>>

<<widget "painstatbar">>
	<div id="paincaptionstat">
		<div class="meter">
			<<set _statkey to 'paincaption'>>
			<<set _percent to Math.floor(($pain/100)*100)>>
			<<set _minPercent to Math.clamp(Math.floor((statChange.minPain() / 100)*100), 0, _percent)>>
			<<if $pain gte 100 and $willpowerpain is 0>>
				<<set _statColor to "redbar">>
			<<elseif $pain gte 80>>
				<<set _statColor to "pinkbar">>
			<<elseif $pain gte 60>>
				<<set _statColor to "purplebar">>
			<<elseif $pain gte 40>>
				<<set _statColor to "bluebar">>
			<<elseif $pain gte 20>>
				<<set _statColor to "lbluebar">>
			<<elseif $pain gte 1>>
				<<set _statColor to "tealbar">>
			<<else>>
				<<set _statColor to "greenbar">>
			<</if>>
			<<run window.Dynamicest?.statChange()>>
			<div @class="_statColor" @style="'width:' + _percent + '%'"></div>
			<<if $pain gt 100>>
				<div @class="$willpowerpain === 0 ? 'dangerbar' : 'redbar'" @style="'width:' + ($pain - 100) + '%'"></div>
			<<elseif _minPercent>>
				<div @class="_statColor + ' meterMin'" @style="'width:' + _minPercent + '%'"></div>
			<</if>>
		</div>
	</div>
<</widget>>

<<widget "allurestatbar">>
	<<if Number.isFinite($allure)>>
		<div id="allurecaptionstat">
			<div class="meter">
				<<set _statkey to 'allurecaption'>>
				<<set _percent=Math.floor(($allure/(8000 * $settings.allureModifier))*100)>>
				<<run window.Dynamicest?.allureChange()>>
				<<if $allure gte (6000 * $settings.allureModifier)>>
				<<print '<div class="redbar" style="width:' + _percent + '%"></div>'>>
				<<elseif $allure gte (4000 * $settings.allureModifier)>>
				<<print '<div class="pinkbar" style="width:' + _percent + '%"></div>'>>
				<<elseif $allure gte (3000 * $settings.allureModifier)>>
				<<print '<div class="purplebar" style="width:' + _percent + '%"></div>'>>
				<<elseif $allure gte (2000 * $settings.allureModifier)>>
				<<print '<div class="bluebar" style="width:' + _percent + '%"></div>'>>
				<<elseif $allure gte (1500 * $settings.allureModifier)>>
				<<print '<div class="lbluebar" style="width:' + _percent + '%"></div>'>>
				<<elseif $allure gte (1000 * $settings.allureModifier)>>
				<<print '<div class="tealbar" style="width:' + _percent + '%"></div>'>>
				<<else>>
				<<print '<div class="greenbar" style="width:' + _percent + '%"></div>'>>
				<</if>>
				<<run window.Dynamicest?.allureChangeFinish()>>
			</div>
		</div>
	<</if>>
<</widget>>

<<widget "drunkstatbar">>
	<<if $drunk gt 0>>
		<div id="drunkcaptionstat">
			<<set $_colour to getColourClassFromPercentage($drunk * (100 / 480), "drunk")>>
			<<set $_barColour to $_colour + "bar">>
			<<set $_percent to Math.floor(($drunk/1000)*100)>>
			<<set $_barWidth to `width:${$_percent}%`>>
			<<set _statkey to 'drunkcaption'>>

			<<set [$_barColour, $_barWidth] to window.Dynamicest?.statChangeDrunk($_barColour, $_percent)>>
			<div class="meter">
				<div @class="$_barColour" @style="$_barWidth"></div>
			</div>
		</div>
	<</if>>
<</widget>>

<<widget "druggedstatbar">>
	<<if $drugged gt 0>>
		<div id="druggedcaptionstat">
			<<set $_colour to getColourClassFromPercentage($drugged / 5, "drugged")>>
			<<set $_barColour to $_colour + "bar">>
			<<set $_percent to Math.floor(($drugged/1000)*100)>>
			<<set $_barWidth to `width:${$_percent}%`>>
			<<set _statkey to 'druggedcaption'>>

			<<set [$_barColour, $_barWidth] to window.Dynamicest?.statChangeDrunk($_barColour, $_percent)>>
			<div class="meter">
				<div @class="$_barColour" @style="$_barWidth"></div>
			</div>
		</div>
	<</if>>
<</widget>>

<<widget "hallucinogenstatbar">>
	<<if $hallucinogen gt 0>>
		<div id="hallucinogencaptionstat">
			<<set $_colour to getColourClassFromPercentage($hallucinogen / 5, "hallucinogen")>>
			<<set $_barColour to $_colour + "bar">>
			<<set $_percent to Math.floor(($hallucinogen/1000)*100)>>
			<<set $_barWidth to `width:${$_percent}%`>>
			<<set _statkey to 'hallucinogencaption'>>

			<<set [$_barColour, $_barWidth] to window.Dynamicest?.statChangeDrunk($_barColour, $_percent)>>
			<div class="meter">
				<div @class="$_barColour" @style="$_barWidth"></div>
			</div>
		</div>
	<</if>>
<</widget>>