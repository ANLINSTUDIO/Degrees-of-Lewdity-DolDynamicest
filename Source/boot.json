{
    "name": "Dynamicest",
    "nickName": "极致动态 - 动态弹窗提醒，不错过任何一个细微的变化",
    "version": "3.0",
    "styleFileList": [
        "dynamicest.css"
    ],
    "scriptFileList": [
        "dynamicest.js"
    ],
    "tweeFileList": [
        "settings.twee"
    ],
    "imgFileList": [
        "img/dynamicest/logo.png"
    ],
    "addonPlugin": [
        {
            "modName": "TweeReplacer",
            "addonName": "TweeReplacerAddon",
            "modVersion": "^1.0.0",
            "params": [
                {
                    "passage": "overlayReplace",
                    "findRegex": "<<optionsinformation>><<\\/replace>>[\\s\\S]*?<<\\/button>>",
                    "regexFlag": "g",
                    "replace": "<<optionsinformation>><</replace>>\n\t\t<</button>><<dynamicestModTab>>"
                }
            ]
        },
        {
            "modName": "BeautySelectorAddon",
            "addonName": "BeautySelectorAddon",
            "modVersion": "^2.0.0",
            "params": {
                "type": "(请确保启用此图像包) 极致动态 - 动态弹窗提醒，不错过任何一个细微的变化"
            }
        }
    ],
    "dependenceInfo": [
        {
            "modName": "GameVersion",
            "version": ">=0.5.10.12"
        },
        {
            "modName": "ModLoader",
            "version": "^2.31.2"
        },
        {
            "modName": "TweeReplacer",
            "version": "^1.0.0"
        },
        {
            "modName": "BeautySelectorAddon",
            "version": "^2.0.0"
        }
    ]
}